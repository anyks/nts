#!/bin/sh

# Сценарий после установки пакета nts
#
# Пакет ставит раскладку экосистемы anyks силами IPS: заголовки, обе библиотеки,
# cmake-файлы со ссылкой lib/cmake/nts и текст лицензии. Библиотеки лежат в
# /usr/lib/amd64/anyks - каталоге, которого нет в пути 64-битного загрузчика,
# потому сценарий расширяет этот путь утилитой crle, сохраняя прежние каталоги

# Выводим сообщение о запуске процесса настройки
echo "Configure 64-bit library path started"

# Текущий путь поиска 64-битного загрузчика
OLD_PATH=$(crle -64 2> /dev/null | sed -n 's/^.*Default Library Path.*:[[:space:]]*//p')
# Каталог библиотек экосистемы anyks
NEW_PATH="/usr/lib/amd64/anyks"

# Если каталог ещё не входит в путь загрузчика
case ":$OLD_PATH:" in
	*":$NEW_PATH:"*) ;;
	*)
		# Расширяем путь, сохраняя прежние каталоги
		if [ -n "$OLD_PATH" ]; then
			crle -64 -l "$NEW_PATH:$OLD_PATH" > /dev/null 2>&1
		else
			crle -64 -l "$NEW_PATH" > /dev/null 2>&1
		fi
	;;
esac

# Выводим сообщение о завершении настройки
echo "Configure 64-bit library path finished"

# Завершаем установку
exit 0
