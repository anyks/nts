#!/bin/sh

# Сценарий после установки пакета nts
#
# Пакет ставит раскладку экосистемы anyks силами pkgbuild: заголовки, обе
# библиотеки, cmake-файлы и ссылку экосистемного поддерева
# lib/cmake/anyks/nts -> ../nts, фреймворк. Отдельных действий раскладка не
# требует: install_name динамической библиотеки записан абсолютным путём, и
# загрузчик находит её сам. Здесь лишь проверяется целость ссылки поддерева -
# отдельные редакторы пакетов способны развернуть её в копию каталога

echo "Post installation process started"

# Проверяем ссылку экосистемного поддерева cmake
if [ ! -e /usr/local/lib/cmake/anyks/nts ]; then
	# Восстанавливаем ссылку поверх физического каталога cmake/nts
	ln -sfn ../nts /usr/local/lib/cmake/anyks/nts
fi

echo "Post installation process finished"

# Завершаем установку
exit 0
